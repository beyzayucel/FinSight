# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Kafka (notification modulu) ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
NOTIFICATION_TOPIC=finsight.notification.requested.v1
NOTIFICATION_GROUP_ID=notification-service
NOTIFICATION_DLT_SUFFIX=.DLT
NOTIFICATION_TOPIC_PARTITIONS=3
NOTIFICATION_TOPIC_REPLICAS=1
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INITIAL_INTERVAL=1s
NOTIFICATION_RETRY_MULTIPLIER=2
NOTIFICATION_RETRY_MAX_INTERVAL=4s
KAFKA_PRODUCER_MAX_BLOCK_MS=5000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=10000
KAFKA_ADMIN_REQUEST_TIMEOUT_MS=5000
KAFKA_ADMIN_DEFAULT_API_TIMEOUT_MS=5000
KAFKA_LISTENER_CONCURRENCY=3
KAFKA_UI_PORT=8090

# === Mail (notification modulu - Mailpit dev ortaminda sahte SMTP) ===
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@finsight.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

# === Rate Limiter ===
LOGIN_RATE_LIMIT_BLOCK_DURATION=5m
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_DURATION=1m

# === JWT ===
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=dev

# === Admin Seed ===
ADMIN_EMAIL=admin@infina.com
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_PHONE_NUMBER=+905551234567
