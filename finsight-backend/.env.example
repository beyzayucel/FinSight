# === Database (Microsoft SQL Server) ===
DB_HOST=localhost
DB_PORT=1433
DB_NAME=finsight
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Pass123
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
MSSQL_PID=Developer

# === World News API ===
NEWS_API_URL=https://api.worldnewsapi.com/search-news
NEWS_API_TOKEN=your-world-news-api-key

# === DeepL Translation API ===
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_API_KEY=your-deepl-api-key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Kafka (notification modulu) ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
NOTIFICATION_TOPIC=finsight.notification.requested.v1
NOTIFICATION_GROUP_ID=notification-service
NOTIFICATION_DLT_SUFFIX=.DLT
NOTIFICATION_TOPIC_PARTITIONS=3
NOTIFICATION_TOPIC_REPLICAS=1
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INITIAL_INTERVAL=1s
NOTIFICATION_RETRY_MULTIPLIER=2
NOTIFICATION_RETRY_MAX_INTERVAL=4s
KAFKA_PRODUCER_MAX_BLOCK_MS=5000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=10000
KAFKA_ADMIN_REQUEST_TIMEOUT_MS=5000
KAFKA_ADMIN_DEFAULT_API_TIMEOUT_MS=5000
KAFKA_LISTENER_CONCURRENCY=3
KAFKA_UI_PORT=8090

# === Mail (notification modulu - Mailpit dev ortaminda sahte SMTP) ===
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@finsight.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

# === Rate Limiter ===
LOGIN_RATE_LIMIT_BLOCK_DURATION=5m
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_DURATION=1m

# === JWT ===
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === Spring Profile ===
SPRING_PROFILES_ACTIVE=dev

# === Admin Seed ===
ADMIN_EMAIL=admin@infina.com
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_PHONE_NUMBER=+905551234567
ADMIN_PASSWORD=ChangeMe!2026

# === OTP Configuration ===
OTP_EXPIRE_DURATION=3m
OTP_COOLDOWN_DURATION=60s
OTP_MAX_ATTEMPTS=5
OTP_ABUSE_MAX_CYCLES=3
OTP_ABUSE_BLOCK_DURATION=30m
OTP_ABUSE_WINDOW_DURATION=1h

# === Verification ===
VERIFICATION_BASE_URL=http://localhost:8080/api/v1/auth/verify?token=
VERIFICATION_EXPIRE_DAYS=1

# === Infina API Entegration ===
INFINA_API_URL=https://apipreprod.infina.com.tr/infina-services/rest/srv/v1.1
INFINA_API_KEY=api-key

# === Password Reset ===
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password?token=
PASSWORD_RESET_EXPIRE_DURATION=30m

# === Caffeine Cache (Performance Comparison) ===
PERF_CACHE_MAX_SIZE=200
PERF_CACHE_EXPIRE_HOURS=6

# === Stock Price Refresh ===
STOCK_PRICE_REFRESH_CRON=0 30 8-17 * * *
STOCK_PRICE_REFRESH_ZONE=Europe/Istanbul
STOCK_PRICE_HISTORY_WINDOW_DAYS=90

# === ONNX Runtime Threading Parameters ===
INTRA_OP_NUM_THREADS=2
INTER_OP_NUM_THREADS=1

# === Monitoring (Prometheus & Grafana) ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# === Password Reset Rate Limit ===
PASSWORD_RESET_RATE_LIMIT_MAX_PER_EMAIL=3
PASSWORD_RESET_RATE_LIMIT_DURATION=15m
PASSWORD_RESET_COOLDOWN_DURATION=60s

# === Password History ===
PASSWORD_HISTORY_SIZE=3

# === Logging ===
LOG_PATH=./logs
